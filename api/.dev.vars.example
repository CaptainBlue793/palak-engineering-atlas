# Copy to .dev.vars for local development (`npm run dev`). .dev.vars is git-ignored.
SERVER_SECRET=local-dev-secret-change-me
# Leave empty locally: with DEV_MODE=1 the code is returned in the API response and printed
# in the terminal instead of being emailed. NEVER set DEV_MODE on the deployed Worker.
RESEND_API_KEY=
DEV_MODE=1
