rules_version = '2';

// Each account owns exactly one document, users/{uid}, holding its synced progress.
// Nobody can list users or read anyone else's progress.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }

      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['progress', 'profile', 'updatedAt'])
        && request.resource.data.progress is map
        && request.resource.data.progress.size() <= 400;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
